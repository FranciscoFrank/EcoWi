    <string name="alert_ports">Devices plugged in</string>
    <string name="alert_ports_desc">A load appeared on a USB, Type-C or 12 V port. The station reports AC outlets together, so they share one alert.</string>
    <string name="alerts_footer_live">Live mode is on: alerts arrive within seconds.</string>
    <string name="alerts_footer_periodic">Without live mode the state is checked every few minutes, so alerts may be late and short plug-ins may be missed.</string>

