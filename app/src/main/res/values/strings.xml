    <!-- Alerts screen -->
    <string name="alerts_permission_title">Allow notifications</string>
    <string name="alerts_permission_text">Without permission EcoWi can\'t tell you about low battery or charging.</string>
    <string name="alerts_permission_action">Allow</string>
    <string name="live_mode_title">Live mode</string>
    <string name="live_mode_desc">Keeps a connection to the station like the EcoFlow app does, so widgets and alerts update within seconds. Shows an ongoing notification (in the Now Bar on One UI 8).</string>
    <string name="live_mode_needs_account">Available only when connected through an EcoFlow account.</string>
    <string name="live_running">Connected</string>
    <string name="live_starting">Connecting…</string>
    <string name="refresh_title">Background refresh</string>
    <string name="refresh_desc">How often to check the station without live mode. Android may delay intervals under 15 min while the phone is idle; tapping a widget always refreshes right away.</string>
    <string name="minutes_short">%1$d min</string>
    <string name="battery_opt_title">Battery restrictions</string>
    <string name="battery_opt_text">One UI may put EcoWi to sleep in the background. Allow unrestricted use so the connection isn\'t cut.</string>
    <string name="battery_opt_action">Remove restriction</string>
    <string name="nowbar_title">Now Bar</string>
    <string name="nowbar_text">Android hasn\'t allowed EcoWi to post Live notifications yet. Turn the option on for EcoWi in notification settings.</string>
