<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview of the 1×1 mini/ring: same geometry as widget_ring_small (square card, centred
     ring). The picker renders previews without our code, so the text auto-sizes to the space instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/w_bg_square"
        android:tint="@color/ew_w_bg_dark" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/preview_ring" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="24dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/preview_soc"
        android:tint="@color/ew_w_text_dark" />
</FrameLayout>
