<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview of the bar (sample values, brand dark look). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg_shape"
        android:tint="@color/ew_w_bg_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/preview_soc"
            android:tint="@color/ew_w_text_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/preview_bar" />

            <TextView
                style="@style/EW.Widget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/preview_caption"
                android:textColor="@color/ew_w_text2_dark" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/w_solid"
            android:tint="@color/ew_w_track_dark" />

        <ImageView
            style="@style/EW.Widget.LoadIcon"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_ac"
            android:tint="@color/ew_w_accent_dark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                style="@style/EW.Widget.LoadValue"
                android:text="@string/preview_load"
                android:textColor="@color/ew_w_text_dark" />

            <TextView
                style="@style/EW.Widget.LoadLabel"
                android:text="@string/label_ac"
                android:textColor="@color/ew_w_text2_dark" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
