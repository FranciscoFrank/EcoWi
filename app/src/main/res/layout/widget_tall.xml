<?xml version="1.0" encoding="utf-8"?>
<!-- Bar widget inside a 2+ row stack (e.g. 4×2). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/part_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/charge_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt"
                android:visibility="gone" />

            <TextView
                android:id="@+id/soc_text"
                style="@style/EW.Widget.Soc.Large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/soc_unknown" />

            <include layout="@layout/part_load" />
        </LinearLayout>

        <include
            layout="@layout/part_bar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/caption_text"
            style="@style/EW.Widget.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/caption_loading" />
    </LinearLayout>
</FrameLayout>
