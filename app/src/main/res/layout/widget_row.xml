<?xml version="1.0" encoding="utf-8"?>
<!-- 5×1 / 4×1 bar. Root id must be @android:id/background (Android 12+ widget clipping). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/part_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/charge_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bolt"
            android:visibility="gone" />

        <TextView
            android:id="@+id/soc_text"
            style="@style/EW.Widget.Soc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="54dp"
            android:text="@string/soc_unknown" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <include layout="@layout/part_bar" />

            <TextView
                android:id="@+id/caption_text"
                style="@style/EW.Widget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/caption_loading" />
        </LinearLayout>

        <ImageView
            android:id="@+id/divider"
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/w_solid" />

        <include
            layout="@layout/part_load"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</FrameLayout>
