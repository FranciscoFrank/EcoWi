# Normalise line endings in the repository; check out with the platform's native endings.
* text=auto

# Scripts that must keep their line endings
gradlew text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf

# Binary files
*.jar   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.ttf   binary
*.otf   binary
